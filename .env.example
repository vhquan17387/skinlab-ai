# =============================================================================
# Backend selection
# =============================================================================
# Which backend implements DataStore / BlobStore / AuthBackend.
#   local    -> Postgres (pg) + filesystem + HMAC cookie auth   (default)
#   supabase -> Supabase Postgres + Storage + Supabase Auth
BACKEND=local

# =============================================================================
# App + AI provider
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Skin analysis provider: mock (default, no API key) | claude
SKIN_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Default claude-opus-4-7. Override: claude-sonnet-4-6 (~2x cheaper),
# claude-haiku-4-5 (~5x cheaper).
CLAUDE_MODEL=claude-opus-4-7

# =============================================================================
# BACKEND=local
# =============================================================================
DATABASE_URL=postgresql://skinai:skinai@localhost:5432/skinai
# Filesystem root for private image storage (gitignored).
LOCAL_STORAGE_DIR=.local-storage
# HMAC secret for signing local /api/files URLs.
LOCAL_STORAGE_SECRET=change-me-local-storage-secret
# Single admin account (Phase 0 / local dev only).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
# HMAC secret for the admin session cookie.
SESSION_SECRET=change-me-session-secret
# Admin session lifetime, seconds (default 8h).
SESSION_TTL=28800
# Signed image URL lifetime, seconds.
SIGNED_URL_TTL=600
# Pepper mixed into SHA-256(IP) before storage. Raw IP is never persisted.
IP_HASH_PEPPER=change-me-ip-pepper

# =============================================================================
# BACKEND=supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=skin-images

# =============================================================================
# Email (optional — skipped entirely if RESEND_API_KEY is unset)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=SkinAI Lab <noreply@example.com>
